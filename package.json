{
  "name": "spell-vs-steel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/artifact.mjs",
    "build:prod": "tsc --noEmit && vite build --mode prod && node scripts/artifact.mjs dist-prod",
    "build:lowpoly": "tsc --noEmit && vite build --mode lowpoly && node scripts/artifact.mjs dist-lowpoly",
    "sim": "tsx scripts/sim.ts",
    "balance": "tsx scripts/balance.ts",
    "typecheck": "tsc --noEmit && tsc -p tests --noEmit",
    "preview": "vite preview",
    "netcheck": "tsx scripts/netcheck.ts",
    "golden": "tsx scripts/golden.ts --check",
    "golden:write": "tsx scripts/golden.ts --write",
    "netsoak": "tsx scripts/netsoak.ts",
    "combocheck": "tsx scripts/combo-check.ts",
    "replaycheck": "tsx scripts/replay-check.ts",
    "rankedcheck": "tsx scripts/ranked-check.ts && tsx scripts/bracket-check.ts",
    "peerserver": "peerjs --port 9000 --host 127.0.0.1",
    "rollcheck": "tsx scripts/rollcheck.ts",
    "fuzz": "tsx scripts/fuzz.ts",
    "fuzz:ui": "vite build --minify false --outDir dist-fuzz && node scripts/uifuzz.mjs",
    "perf": "vite build && node scripts/perf.mjs",
    "test": "tsx tests/saves.ts && tsx tests/mods.ts && tsx tests/matches.ts && tsx tests/scene-stack.ts && tsx tests/gamepad.ts && tsx tests/deckCode.ts && tsx tests/planCosts.ts && tsx scripts/netcheck.ts && tsx scripts/combo-check.ts && tsx scripts/rollcheck.ts 25",
    "fx:sheet": "vite build --config tests/fx/vite.config.ts --logLevel warn && tsx tests/fx/run.ts",
    "test:screens": "vite build --config tests/screens/vite.config.ts && tsx tests/screens/run.ts",
    "desktop": "npm run build:prod && electron .",
    "dist:win": "npm run build:prod && electron-builder --win portable",
    "dist:linux": "npm run build:prod && electron-builder --linux AppImage",
    "android:sync": "npm run build:prod && cap sync android"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/node": "^22.20.5",
    "@types/three": "^0.160.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "peer": "^1.0.2",
    "playwright": "^1.63.0",
    "three": "^0.160.0",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "peerjs": "^1.5.5"
  },
  "description": "Spell VS Steel",
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.wesleyt4n.spellvssteel",
    "productName": "Spell VS Steel",
    "artifactName": "SpellVsSteel-${version}-${os}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "dist-prod/index.html",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png",
      "category": "Game"
    }
  }
}
