{
  "name": "spell-vs-steel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/artifact.mjs",
    "build:prod": "tsc --noEmit && vite build --mode prod && node scripts/artifact.mjs dist-prod",
    "sim": "tsx scripts/sim.ts",
    "typecheck": "tsc --noEmit && tsc -p tests --noEmit",
    "preview": "vite preview",
    "netcheck": "tsx scripts/netcheck.ts",
    "combocheck": "tsx scripts/combo-check.ts",
    "peerserver": "peerjs --port 9000 --host 127.0.0.1",
    "test": "tsx tests/saves.ts && tsx tests/matches.ts && tsx scripts/netcheck.ts && tsx scripts/combo-check.ts",
    "test:screens": "vite build --config tests/screens/vite.config.ts && tsx tests/screens/run.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "peer": "^1.0.2",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4"
  },
  "dependencies": {
    "peerjs": "^1.5.5"
  }
}
