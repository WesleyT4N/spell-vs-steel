{
  "name": "spell-vs-steel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/artifact.mjs",
    "build:prod": "tsc --noEmit && vite build --mode prod && node scripts/artifact.mjs dist-prod",
    "sim": "tsx scripts/sim.ts",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "netcheck": "tsx scripts/netcheck.ts",
    "combocheck": "tsx scripts/combo-check.ts",
    "peerserver": "peerjs --port 9000 --host 127.0.0.1",
    "fuzz": "tsx scripts/fuzz.ts",
    "fuzz:ui": "vite build --minify false --outDir dist-fuzz && node scripts/uifuzz.mjs",
    "perf": "vite build && node scripts/perf.mjs"
  },
  "devDependencies": {
    "peer": "^1.0.2",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4"
  },
  "dependencies": {
    "peerjs": "^1.5.5"
  }
}
